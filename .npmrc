# Supply-chain hardening: do not run dependency lifecycle scripts (preinstall/install/postinstall)
# during `npm install` / `npm ci`. The only packages in package-lock.json with install scripts are
# unrs-resolver (napi-postinstall fallback; its native binding is delivered through the
# @unrs/resolver-binding-* optional dependencies) and fsevents (macOS-only, ships a prebuilt binary).
# If a newly added dependency really needs its install script, review it and run it explicitly,
# e.g. `npm rebuild <package>`, instead of turning this setting off.
ignore-scripts=true
